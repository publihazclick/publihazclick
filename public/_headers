# Equivalente Cloudflare Pages de los "headers" de vercel.json.
# Cuando varias reglas coinciden con la misma URL, Pages aplica todas y para un mismo
# header gana la ULTIMA. Por eso las reglas de cache de los assets van al final, igual
# que en vercel.json, donde la regla de assets iba despues del catch-all.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self)
  Cache-Control: no-cache, no-store, must-revalidate

/robots.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8

/sitemap.xml
  Cache-Control: public, max-age=86400
  Content-Type: application/xml; charset=utf-8

/llms.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8

/manifest.webmanifest
  Cache-Control: public, max-age=604800
  Content-Type: application/manifest+json

# APK del conductor. Se conserva por si alguien todavia llega por este link viejo;
# la descarga oficial vive en Supabase Storage.
/downloads/*.apk
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment; filename="movi-conductor.apk"
  Cache-Control: public, max-age=300, must-revalidate

# Assets con hash en el nombre: se pueden cachear para siempre sin riesgo.
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.css
  Cache-Control: public, max-age=31536000, immutable
/*.woff
  Cache-Control: public, max-age=31536000, immutable
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/*.ttf
  Cache-Control: public, max-age=31536000, immutable
/*.ico
  Cache-Control: public, max-age=31536000, immutable
/*.webp
  Cache-Control: public, max-age=31536000, immutable
/*.png
  Cache-Control: public, max-age=31536000, immutable
/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/*.svg
  Cache-Control: public, max-age=31536000, immutable
